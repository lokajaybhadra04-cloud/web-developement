<% layout("/layouts/boilerplate") %>

<body>

<div class="listing-container">

    <h1 class="listing-title"><%= listing.title %></h1>

    <img 
        src="<%= listing.image %>" 
        alt="<%= listing.title %>" 
        class="listing-image"
    >

    <br/>
    <p class="detail-label">Hosted by:
        <i> <%= listing.owner.username %> </i></p>


        <br />
<div class="listing-details">

    <p class="listing-description">
        <i class="fa-solid fa-align-left detail-icon"></i>
        


      <p>  <span class="detail-label">Description:</span>
        <%= listing.description %></p>
    </p>

    <p class="listing-price">
        <i class="fa-solid fa-indian-rupee-sign detail-icon"></i>
        <span class="detail-label">Price:</span>
        &#8377;<%= listing.price.toLocaleString("en-IN") %> / night
    </p>

    <p class="listing-location">
        <i class="fa-solid fa-location-dot detail-icon"></i>
        <span class="detail-label">Location:</span>
        <%= listing.location %>
    </p>

    <p class="listing-country">
        <i class="fa-solid fa-earth-asia detail-icon"></i>
        <span class="detail-label">Country:</span>
        <%= listing.country %>
    </p>
     <!-- add location and country and category -->
    <p class="listing-category">
        <i class="fa-solid fa-tag detail-icon"></i>
        <span class="detail-label">Category:</span>
        <%= listing.category %>
    </p>
    

</div>


<div class="listing-buttons">

        <!-- Update -->
        <form action="/listing/<%= listing._id %>/edit" method="GET">
            <button class="btn-edit">Update Listing</button>
        </form>

        <!-- Delete -->
        <form action="/listing/<%= listing._id %>/delete" method="POST">
            <button class="btn-delete">Delete Listing</button>
        </form>

    </div>


    <!-- to see createdAt and updatedAt -->
    <p class="listing-timestamps">
        <i class="fa-solid fa-clock detail-icon"></i>
        <span class="detail-label">Created At:</span>
        <%= listing.createdAt.toLocaleString("en-IN")%>
        <br>
        <span class="detail-label">Updated At:</span>
        <%= listing.updatedAt.toLocaleString("en-IN") %>
    </p>
        

<hr/>
  


<!-- to add reviews in the listing -->


<!-- Review Section -->
<div class="review-section">

    <h4 class="review-heading">
        <i class="fa-solid fa-star review-icon"></i>
        Leave a Review
    </h4>



    <form class="review-form  needs-validation "  action ="/listing/<%=listing.id %>/reviews" method="POST"  novalidate  >

        <!-- Rating -->
        <div class="form-group mb-3 mt-3" >
            <label>
                <i class="fa-solid fa-ranking-star form-icon"></i>
                Rating
            </label>

            <select class="review-input" id="rating" name="review[rating]">
                <option value="1">1 Star</option>
                <option value="2">2 Stars</option>
                <option value="3">3 Stars</option>
                <option value="4">4 Stars</option>
                <option value="5">5 Stars</option>
            </select>
        </div>




        <!-- Comment -->
        <div class="form-group mb-3 mt-3">
            <label>
                <i class="fa-solid fa-comment form-icon"></i>
                Comment
            </label>
        </br>
            <textarea 
                class="review-textarea"
                placeholder="Write your review here..."
                name="review[comment]"
                id="comment"
                rows="5"
                cols="30"
                required 

                ></textarea>
                <div class="invalid-feedback">
    Please enter a review comment.
</div>
        </div>

        <!-- Button -->
        <button class="review-btn">
            <i class="fa-solid fa-paper-plane"></i>
            Submit Review
        </button>

    </form>


    <hr />

    <div class="review-section mt-4">
    <h4>All Reviews</h4>

    <div class="row">
        <% listing.reviews.forEach(function(review) { %>
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="review-item">
                    <!-- add star icons  yellow color  -->
                 <p class="review-rating">
                   <% for(let i = 0; i < review.rating; i++) { %>
                   <i class="fa-solid fa-star text-warning"></i>
                    <% } %>
                </p>
                    <p><strong>Comment:</strong> <%= review.comment %></p>
                    <!-- delete the review -->
                 <form action="/listing/<%= listing._id %>/reviews/<%= review._id %>/delete" method="POST">
                    <button class="btn btn-danger">Delete Review</button>
                  </form>
                   
                </div>
            </div>
        <% }) %>
    </div>
</div>


  <a href="/listing" class="back-link">Back to all listings</a>




</div>

</body>